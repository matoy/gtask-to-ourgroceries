# --- Google Keep (Recommandé pour Gemini for Home / Google Home) ---
GOOGLE_KEEP_EMAIL="votre-email@gmail.com"
GOOGLE_KEEP_MASTER_TOKEN="aas_et/votre-master-token-google-keep"
# Un ou plusieurs IDs (ou titres exacts) séparés par des virgules, y compris listes partagées
GOOGLE_KEEP_NOTE_ID="id-liste-1,id-liste-2-partagee"

# --- OurGroceries ---
OG_USERNAME="votre-email@exemple.com"
OG_PASSWORD="votre-mot-de-passe-ourgroceries"
OG_LIST_ID="votre-id-de-liste-ourgroceries"

# --- Gemini AI (Smart Matching gratuit via Google AI Studio) ---
GEMINI_API_KEY="AIzaSy-votre-cle-gratuite-google-ai-studio"

# --- Sécurité & Réglages (Optionnels) ---
# Token secret pour protéger l'endpoint /api/sync (utilisé par cron-job.org)
CRON_SECRET="changez-moi-par-une-chaine-aleatoire"
# Modèle Gemini utilisé si GEMINI_API_KEY est défini (défaut : gemini-3.5-flash-lite)
GEMINI_MODEL="gemini-3.5-flash-lite"
# Seuil de tolérance du Fuzzy Matching de secours (entre 0.0 et 1.0, défaut : 0.75)
MATCH_CUTOFF="0.75"
